DATABASE_URL="postgresql://postgres:password@localhost:5432/hostelcare?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@hostelcare.local
WARDEN_EMAIL=warden@hostelcare.local
# Optional SMTP delivery. In-app alerts work without these settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HostelCare <alerts@hostelcare.local>"
ESCALATION_CHECK_MINUTES=5
# Optional: when set, student registration requires this code.
STUDENT_SIGNUP_CODE=
